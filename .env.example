VITE_API_URL=http://localhost:4000

# Firebase (copied from provided config; adjust if you rotate keys)
VITE_FIREBASE_API_KEY=REDACTED_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vibingclip
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=REDACTED_FIREBASE_SENDER_ID
VITE_FIREBASE_APP_ID=REDACTED_FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=REDACTED_FIREBASE_MEASUREMENT_ID

# Optional demo credentials (used only if you call authService.ensureAuth())
VITE_DEMO_EMAIL=demo@vibingclip.com
VITE_DEMO_PASSWORD=demo1234
VITE_DEMO_NAME=Vibing Demo
